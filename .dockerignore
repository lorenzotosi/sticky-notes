# The image build context is the repository root, but an image copies only the
# artifacts it needs. Everything else is excluded here, so the context stays
# small and no source, cache or secret reaches the image.

.git
.github
.idea
.gradle
.gradle-user-home
.kotlin
.metals
.vscode
node_modules
**/node_modules
coverage
**/coverage
outputs
scratch
test-fixtures
*.log
.env
.env.*
!.env.example
.DS_Store
**/.DS_Store

# Build outputs are regenerated by the build. The backend JAR is the single
# artifact the runtime image consumes, so it is kept in the context.
**/build
!backend/build
backend/build/*
!backend/build/libs
backend/build/libs/*
!backend/build/libs/backend.jar
