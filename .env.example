# Local configuration of the Compose stack.
#
# In a source checkout, `scripts/start-local.sh` copies this file to `.env`
# when no `.env` exists. The real `.env` stays out of Git and holds the local
# configuration; a release bundle ships it generated with its image references.
#
# The credentials below are demonstration values for a Docker network that is
# not reachable from outside the machine. MongoDB creates the database user on
# the first start of an empty volume, so changing the credentials afterwards
# requires removing the volume, which deletes the board. Keep the password free
# of characters that need URL encoding, because it is embedded in the MongoDB
# connection URI.

# Images of the stack. A release replaces them with the published references;
# the version and the revision are stamped into the bundle `compose.yaml`.
API_IMAGE=sticky-notes-backend:local
WEB_IMAGE=sticky-notes-web:local

# Host ports. The delivery stack publishes only the web interface; the API and
# MongoDB ports are used by the development override.
WEB_PORT=8080
API_PORT=8080
MONGO_PORT=27017

# Database of the single shared board.
MONGO_USER=stickynotes_user
MONGO_PASSWORD=stickynotes_local_password
MONGO_DATABASE=stickynotes
