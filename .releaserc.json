{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "sticky-notes-deliverables.zip",
            "label": "Compiled application deliverables"
          }
        ]
      }
    ]
  ]
}
